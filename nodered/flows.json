    {
        "id": "d26aaffadb89af34",
        "type": "function",
        "z": "8ee472871ed19113",
        "name": "Registrar Presença",
        "func": "var ra = msg.payload.ra;\n\nif (!ra) {\n    msg.statusCode = 400;\n    msg.payload = {\n        sucesso: false,\n        erro: \"RA não informado\"\n    };\n    return msg;\n}\n\nmsg.topic = `\n    INSERT INTO presenca (ra, datahora)\n    SELECT '${ra}', NOW()\n    FROM alunos\n    WHERE ra = '${ra}'\n    LIMIT 1\n`;\n\nmsg.payload = {\n    sucesso: true,\n    ra: ra\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 330,
