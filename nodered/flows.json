    {
        "id": "9eb488266ba64c94",
        "type": "function",
        "z": "8ee472871ed19113",
        "name": "Formatar Indicadores",
        "func": "if (!msg.payload || msg.payload.length === 0) return null;\n\nvar dados = msg.payload[0];\nvar total = dados.total_alunos || 0;\nvar presentes = dados.presentes_hoje || 0;\nvar ausentes = total - presentes;\n\nreturn [\n    { payload: total },\n    { payload: presentes },\n    { payload: ausentes < 0 ? 0 : ausentes }\n];",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
