    {
        "id": "e931af22ce09d665",
        "type": "function",
        "z": "8ee472871ed19113",
        "name": "SQL Contar Alunos",
        "func": "msg.topic = `\n    SELECT \n        (SELECT COUNT(*) FROM alunos) AS total_alunos,\n        (SELECT COUNT(DISTINCT ra) FROM presenca WHERE DATE(datahora) = CURDATE()) AS presentes_hoje;\n`;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 330,
