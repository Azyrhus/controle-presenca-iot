    {
        "id": "12c87bedd6228fa5",
        "type": "function",
        "z": "8ee472871ed19113",
        "name": "SQL Buscar Presenças",
        "func": "msg.topic = `\n    SELECT \n        p.id,\n        a.ra AS RA,\n        a.nome AS Nome,\n        a.curso AS Curso,\n        DATE_FORMAT(p.datahora, '%d/%m/%Y %H:%i:%s') AS 'Data/Hora'\n    FROM presenca p\n    JOIN alunos a ON p.ra = a.ra\n    ORDER BY p.datahora DESC\n    LIMIT 10;\n`;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 350,
